# Copie para .env e preencha. Nunca commite o .env.

# Gateway LiteLLM: endereço e chave do time, entregues pela organização
LITELLM_URL=
LITELLM_API_KEY=

# Modelo no formato provedor:modelo do init_chat_model (o LiteLLM fala o protocolo da OpenAI)
MODELO=openai:gpt-4o-mini

# Endereço do servidor MCP
MCP_URL=http://localhost:8765/mcp

# Nome que aparece no painel em cada chamada
NOME_AGENTE=exemplo-langgraph

# Máximo de passos do grafo por evento
MAX_PASSOS=30
